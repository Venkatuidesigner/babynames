[
{"id":1,"name":"அகரன்","meaning":"முதல் எழுத்து","description":"அகரன் என்பது ஆரம்பத்தை குறிக்கும் தமிழ் பெயர். புதிய தொடக்கங்கள், தலைமைத்துவம் மற்றும் முன்னோடித்தன்மையை குறிக்கிறது.","startingLetter":"அ"},
{"id":2,"name":"அகில்","meaning":"மணம் தரும் மரம்","description":"அகில் என்பது அரிய மணம் வீசும் மரம். உயர்ந்த குணம் மற்றும் மதிப்பை குறிக்கும் பெயர்.","startingLetter":"அ"},
{"id":3,"name":"அகிலன்","meaning":"உலகம்","description":"அகிலன் என்பது உலகத்தை குறிக்கும். பரந்த சிந்தனை மற்றும் மனிதநேய குணம் கொண்டவராக இருப்பார்.","startingLetter":"அ"},
{"id":4,"name":"அன்பு","meaning":"அன்பு","description":"அன்பு என்பது கருணை மற்றும் பாசத்தை குறிக்கும். இந்த பெயர் கொண்டவர்கள் அனைவராலும் விரும்பப்படுபவர்கள்.","startingLetter":"அ"},
{"id":5,"name":"அன்பழகன்","meaning":"அன்பும் அழகும்","description":"அன்பழகன் என்பது உள்ளமும் வெளிப்புறமும் அழகான மனிதரை குறிக்கும் பெயர்.","startingLetter":"அ"},

{"id":6,"name":"அருள்","meaning":"கடவுளின் அருள்","description":"அருள் என்பது தெய்வீக கருணையை குறிக்கும். நல்ல மனம் மற்றும் உதவி செய்யும் குணம் கொண்டவர்.","startingLetter":"அ"},
{"id":7,"name":"அருள்மணி","meaning":"அருளின் முத்து","description":"அருள்மணி என்பது மதிப்பும் அருளும் நிறைந்த நபரை குறிக்கும் பெயர்.","startingLetter":"அ"},
{"id":8,"name":"அருள்செல்வன்","meaning":"அருள் நிறைந்த செல்வம்","description":"குடும்பத்திற்கு பெருமை சேர்க்கும் நபரை குறிக்கும் பெயர்.","startingLetter":"அ"},
{"id":9,"name":"அறிவன்","meaning":"அறிவு உடையவன்","description":"அறிவும் சிந்தனை திறனும் கொண்டவரை குறிக்கும் பெயர்.","startingLetter":"அ"},
{"id":10,"name":"அறிவழகன்","meaning":"அறிவும் அழகும்","description":"அறிவும் குணமும் சேர்ந்த சிறந்த மனிதரை குறிக்கும் பெயர்.","startingLetter":"அ"},

{"id":11,"name":"அழகன்","meaning":"அழகு","description":"அழகான தோற்றமும் குணமும் கொண்டவரை குறிக்கும் பெயர்.","startingLetter":"அ"},
{"id":12,"name":"அழகர்சாமி","meaning":"அழகான கடவுள்","description":"தெய்வீக அழகை குறிக்கும் பெயர்.","startingLetter":"அ"},
{"id":13,"name":"அழகுமணி","meaning":"அழகான முத்து","description":"மதிப்பு மற்றும் அழகை குறிக்கும் பெயர்.","startingLetter":"அ"},
{"id":14,"name":"அழகுசெல்வன்","meaning":"அழகான செல்வம்","description":"குடும்பத்திற்கு மகிழ்ச்சி தரும் நபர்.","startingLetter":"அ"},
{"id":15,"name":"அழகேந்திரன்","meaning":"அழகின் தலைவர்","description":"தலைமை குணம் மற்றும் கவர்ச்சி கொண்டவர்.","startingLetter":"அ"},

{"id":16,"name":"அமுதன்","meaning":"அமுதம்","description":"இனிமையும் நன்மையும் தருபவரை குறிக்கும் பெயர்.","startingLetter":"அ"},
{"id":17,"name":"அமுதவேல்","meaning":"இனிய வேல்","description":"முருகன் தொடர்புடைய பெயர், பக்தி மற்றும் வீரத்தை குறிக்கும்.","startingLetter":"அ"},
{"id":18,"name":"அமுதரசன்","meaning":"இனிய மன்னன்","description":"அமைதி மற்றும் மகிழ்ச்சி தரும் நபர்.","startingLetter":"அ"},
{"id":19,"name":"அமுதகுமார்","meaning":"இனியவன்","description":"இனிமை மற்றும் நல்ல குணம் கொண்டவர்.","startingLetter":"அ"},
{"id":20,"name":"அமுதசெல்வன்","meaning":"இனிய செல்வம்","description":"குடும்ப மகிழ்ச்சியை குறிக்கும் பெயர்.","startingLetter":"அ"},

